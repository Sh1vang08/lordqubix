# Client-side (Vite exposes anything prefixed VITE_ to the browser bundle —
# only put keys here that are safe to be public).
VITE_SUPABASE_URL=https://miqsnuknoscxhnfiazca.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-side only (migration script, admin write operations). NEVER prefix
# this with VITE_ — that would ship it to every visitor's browser. Set the
# real value in Vercel's Environment Variables, not here.
SUPABASE_SERVICE_ROLE_KEY=
